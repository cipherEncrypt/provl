# Kane auth (recommended): leave empty and run:
#   npx @testmuai/kane-cli login --oauth
# Optional CI-style keys instead of OAuth (not used by Provl run route; connect via /connect):
LT_USERNAME=
LT_ACCESS_KEY=

# Required when users connect their own Kane account (32+ char secret; never commit .env)
PROVL_ENC_KEY=

# Optional: MongoDB Atlas connection string for run history (credentials stay on disk)
MONGODB_URI=

# Optional override for scripts/acceptance-cancel.ts (default http://localhost:3000)
PROVL_DEMO_BASE_URL=http://localhost:3000

# Monitors: cron endpoint (Vercel sends Authorization: Bearer <value>)
CRON_SECRET=

# Public site URL for proof links (emails, MCP verify_web_task); default http://localhost:3000
PROVL_PUBLIC_URL=http://localhost:3000

# Optional: Resend (https://resend.com) for automatic NOT DONE monitor emails (not required for in-app + mailto alerts)
RESEND_API_KEY=
# Production: use a verified domain, e.g. Provl <alerts@yourdomain.com>
RESEND_FROM=onboarding@resend.dev
# Local testing with onboarding@resend.dev: must send only to your Resend signup email
RESEND_ALERT_OVERRIDE=