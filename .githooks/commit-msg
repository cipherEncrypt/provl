#!/usr/bin/env sh
# Optional: git config core.hooksPath .githooks
# Strip Cursor co-author trailers before the commit is finalized.
msgfile="$1"
[ -z "$msgfile" ] || [ ! -f "$msgfile" ] && exit 0
tmp=$(mktemp) || exit 0
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    Co-authored-by:*[Cc]ursor*|Co-authored-by:*cursoragent*) ;;
    *) printf '%s\n' "$line" ;;
  esac
done < "$msgfile" > "$tmp" && mv "$tmp" "$msgfile"
exit 0